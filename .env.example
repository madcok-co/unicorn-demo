# Application Configuration
APP_HTTP_HOST=0.0.0.0
APP_HTTP_PORT=8080

# Database Configuration
APP_DB_DRIVER=sqlite
# For SQLite (default - no additional setup needed)
APP_DB_DATABASE=unicorn_demo.db

# For PostgreSQL (uncomment and configure)
# APP_DB_DRIVER=postgres
# APP_DB_HOST=localhost
# APP_DB_PORT=5432
# APP_DB_USER=unicorn
# APP_DB_PASSWORD=unicorn_secret
# APP_DB_DATABASE=unicorn_demo
# APP_DB_SSLMODE=disable

# OAuth2 Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
APP_OAUTH_PROVIDER=google
APP_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
APP_OAUTH_CLIENT_SECRET=your-google-client-secret
APP_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback

# For GitHub OAuth (alternative)
# APP_OAUTH_PROVIDER=github
# APP_OAUTH_CLIENT_ID=your-github-client-id
# APP_OAUTH_CLIENT_SECRET=your-github-client-secret

# For Microsoft OAuth (alternative)
# APP_OAUTH_PROVIDER=microsoft
# APP_OAUTH_CLIENT_ID=your-microsoft-client-id
# APP_OAUTH_CLIENT_SECRET=your-microsoft-client-secret

# Multi-tenancy Configuration
APP_MULTITENANCY_STRATEGY=subdomain
APP_MULTITENANCY_DOMAIN=localhost

# Alternative strategies:
# APP_MULTITENANCY_STRATEGY=header  # Use X-Tenant-ID header
# APP_MULTITENANCY_STRATEGY=path    # Use /tenant-id/api/...
